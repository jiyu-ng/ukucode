---
const { title, description, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname.replace(/\/$/, "");
const isSongs = path === `${base}/songs` || path.startsWith(`${base}/song/`);
const isChords = path === base || path.startsWith(`${base}/chord/`);
const fullTitle = title ? `${title} · 우쿨코드` : "우쿨코드 — 우쿨렐레 코드 사전";
const desc = description || "우쿨렐레 코드 운지법을 다이어그램으로 한눈에. 메이저·마이너·7th 코드 잡는 법을 무료로 찾아보세요.";
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {/* 404 등 유틸리티 페이지는 색인 제외 — 색인되면 soft-404 신호가 되고
        크롤 예산도 낭비된다. 링크는 따라가게 follow 는 유지. */}
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="우쿨코드" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="theme-color" content="#fbf7f2" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문 바로가기</a>
    <header class="site-head">
      <a class="brand" href={`${base}/`}>
        <span class="brand-mark">🎸</span> 우쿨코드
      </a>
      <p class="tagline">우쿨렐레 코드 사전</p>
      <nav class="site-nav" aria-label="주요 메뉴">
        <a href={`${base}/`} aria-current={isChords ? "page" : undefined}>코드</a>
        <a href={`${base}/songs/`} aria-current={isSongs ? "page" : undefined}>곡</a>
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-foot">
      <p>우쿨코드 · 우쿨렐레 코드를 다이어그램으로 쉽게</p>
    </footer>

    <style is:global>
      :root {
        /* --muted 는 14px 이하 본문(내비·태그라인·푸터)에 쓰이므로 WCAG AA 4.5:1 을 넘겨야 한다.
           #8a7f78 은 bg 대비 3.65 로 미달이었다 (2026-09-06 실측). 색상(H)·채도는 그대로 두고 명도만 낮췄다. */
        --bg: #fbf7f2; --card: #ffffff; --ink: #35302c; --muted: #7a706a;
        --line: #ece3da; --accent: #e8503a; --accent-soft: #fdeee9;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      /* 모션 민감 사용자(전정기능 장애 등)를 위해 애니메이션·이동 효과를 최소화 (WCAG 2.3.3) */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
        .card:hover { transform: none; }
      }
      .skip-link {
        position: absolute; left: 8px; top: -48px; z-index: 100;
        background: var(--accent); color: #fff; padding: 8px 14px;
        border-radius: 8px; font-size: 14px; font-weight: 700; text-decoration: none;
        transition: top 0.15s ease;
      }
      .skip-link:focus { top: 8px; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      body {
        margin: 0; background: var(--bg); color: var(--ink);
        font-family: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Pretendard", "Malgun Gothic", sans-serif;
        line-height: 1.6;
      }
      main { max-width: 900px; margin: 0 auto; padding: 8px 18px 40px; }
      a { color: inherit; }
      .site-head { text-align: center; padding: 26px 18px 10px; }
      .brand { display: inline-flex; align-items: center; gap: 7px; font-size: 26px; font-weight: 800; text-decoration: none; letter-spacing: -0.5px; }
      .brand-mark { font-size: 24px; }
      .tagline { margin: 4px 0 0; color: var(--muted); font-size: 13.5px; }
      .site-nav { display: flex; justify-content: center; gap: 8px; margin-top: 12px; }
      .site-nav a {
        text-decoration: none; font-size: 14px; font-weight: 700; color: var(--muted);
        padding: 6px 16px; border-radius: 999px; background: var(--card); border: 1px solid var(--line);
      }
      .site-nav a:hover { color: var(--accent); border-color: var(--accent); }
      .site-nav a[aria-current="page"] {
        color: var(--accent); border-color: var(--accent); background: var(--accent-soft);
      }
      .site-foot { text-align: center; color: var(--muted); font-size: 12.5px; padding: 24px 18px 40px; }

      /* 🖨️ 인쇄 — 우쿨렐레는 곡을 종이로 뽑아 보면대에 올리는 게 실제 사용이다.
         이 블록은 @media print 안에만 있어 화면 표시에는 아무 영향이 없다.
         실측(2026-09-15): print 미디어에서 header 2 · nav 2 · footer 1 · crumb 1 이
         전부 보였고, A4 상단 1/6을 로고·탭이 차지하고 있었다. */
      @media print {
        .site-head, .site-nav, .site-foot, .skip-link, .crumb { display: none !important; }

        /* 잉크를 아끼고 대비를 올린다 */
        body { background: #fff !important; color: #000 !important; }
        a { color: #000 !important; text-decoration: none !important; }

        /* 보면대에서 읽는 크기 — 화면(17px)보다 한 단계 키운다.
           🔴 처음에 15px 로 적어 오히려 줄였다. 렌더해서 재고서야 보였다 —
              화면 기본값을 모르고 절대값을 박으면 방향이 뒤집힌다. */
        .seg-lyric { font-size: 19px !important; }
        .seg-chord { font-weight: 700 !important; }

        /* 코드 다이어그램과 가사 줄이 페이지 경계에서 잘리면 못 쓴다 */
        .sheet, .line, .sec, figure, svg { break-inside: avoid; page-break-inside: avoid; }
        .song-head { break-after: avoid; page-break-after: avoid; }

        /* 카드 테두리·그림자는 종이에서 의미가 없다 */
        .sheet { border: none !important; box-shadow: none !important; padding: 0 !important; }
      }
    </style>
  </body>
</html>
