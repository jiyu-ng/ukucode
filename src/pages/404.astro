---
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Base
  title="페이지를 찾을 수 없어요 (404)"
  description="요청하신 페이지를 찾을 수 없어요. 우쿨코드 홈에서 우쿨렐레 코드와 곡을 찾아보세요."
>
  <section class="notfound">
    <div class="nf-emoji">🎸</div>
    <h1>줄을 헛짚었나 봐요</h1>
    <p>찾으시는 페이지가 없거나 주소가 바뀌었어요.<br />아래에서 다시 찾아보세요!</p>
    <nav class="nf-links" aria-label="이동">
      <a href={`${base}/`}>🎵 코드 사전</a>
      <a href={`${base}/songs/`}>🎶 곡 목록</a>
    </nav>
  </section>

  <style>
    .notfound { text-align: center; padding: 52px 18px 60px; }
    .nf-emoji { font-size: 56px; margin-bottom: 10px; }
    .notfound h1 { font-size: 23px; font-weight: 800; margin: 0 0 12px; }
    .notfound p { color: var(--muted); font-size: 14.5px; line-height: 1.6; margin: 0 0 24px; }
    .nf-links { display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; }
    .nf-links a {
      text-decoration: none; font-size: 14px; font-weight: 700; color: var(--accent);
      padding: 10px 20px; border-radius: 999px; background: var(--card); border: 1px solid var(--accent);
    }
    .nf-links a:hover { background: var(--accent-soft); }
  </style>
</Base>
