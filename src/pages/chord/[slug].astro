---
import Base from "../../layouts/Base.astro";
import ChordDiagram from "../../components/ChordDiagram.astro";
import { CHORDS, QUALITY_LABELS, chordSlug } from "../../data/chords.js";
import { SONGS } from "../../data/songs.js";

export function getStaticPaths() {
  return CHORDS.map((c) => ({ params: { slug: chordSlug(c.name) }, props: { chord: c } }));
}

const { chord } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const STRINGS = ["G", "C", "E", "A"];

// 운지 설명 문장
const fingering = STRINGS.map((s, i) => {
  const f = chord.frets[i];
  return f === 0 ? `${s}현은 개방현(안 누름)` : `${s}현 ${f}프렛`;
}).join(", ");

const qualityLabel = QUALITY_LABELS[chord.quality];
const akaText = chord.aka ? ` (${chord.aka})` : "";
const title = `${chord.name} 코드`;
const description = `우쿨렐레 ${chord.name}${akaText} 코드 잡는 법 — ${fingering}. ${qualityLabel} 코드 운지법을 다이어그램으로 확인하세요.`;

// 관련 코드: 같은 루트 or 같은 품질 (자기 제외, 최대 8개)
const related = CHORDS
  .filter((c) => c.name !== chord.name && (c.root === chord.root || c.quality === chord.quality))
  .slice(0, 8);

// 이 코드가 실제로 쓰이는 노래: 곡 세그먼트의 코드심볼(c)에 이 코드가 있으면 매칭.
// 코드↔노래 상호 내부 링크로 탐색·체류·색인을 높인다(수록곡 없으면 섹션 미표시).
const usedInSongs = SONGS.filter((s) =>
  s.sections.some((sec) =>
    sec.lines.some((line) => line.some((seg) => seg.c === chord.name))
  )
);

// 검색결과 경로(빵부스러기) + 운지법 HowTo 구조화 데이터.
// 코드 상세는 "코드 잡는 법"이라는 단계형 안내(각 현을 어디에 짚는지)라, HowTo로 노출해
// 검색 리치결과 자격을 얻고 코드명 유입을 강화한다. @graph로 BreadcrumbList와 함께 묶는다.
const home = new URL(`${base}/`, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const howToSteps = STRINGS.map((s, i) => {
  const f = chord.frets[i];
  return {
    "@type": "HowToStep",
    name: `${s}현`,
    text: f === 0 ? `${s}현은 개방현으로 두고 누르지 않습니다.` : `${s}현을 ${f}프렛에서 누릅니다.`,
  };
});
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "우쿨코드", item: home },
        { "@type": "ListItem", position: 2, name: `${chord.name} 코드`, item: pageUrl },
      ],
    },
    {
      "@type": "HowTo",
      name: `우쿨렐레 ${chord.name} 코드 잡는 법`,
      description: `우쿨렐레(표준 GCEA 튜닝)에서 ${chord.name} ${qualityLabel} 코드를 잡는 운지법.`,
      inLanguage: "ko-KR",
      url: pageUrl,
      step: howToSteps,
    },
  ],
};
---
<Base title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <nav class="crumb"><a href={`${base}/`}>← 전체 코드</a></nav>

  <article class="chord-page">
    <header class="chord-head">
      <h1>{chord.name} <span class="q">{qualityLabel}</span></h1>
      {chord.aka && <p class="aka">다른 이름: {chord.aka}</p>}
    </header>

    <div class="diagram-wrap">
      <ChordDiagram frets={chord.frets} size={1.7} name={chord.name} />
    </div>

    <section class="howto">
      <h2>{chord.name} 코드 잡는 법</h2>
      <p>{fingering}.</p>
      <table>
        <thead><tr><th>현</th><th>프렛</th></tr></thead>
        <tbody>
          {STRINGS.map((s, i) => (
            <tr>
              <td>{s}현</td>
              <td>{chord.frets[i] === 0 ? "개방현 (0)" : `${chord.frets[i]}프렛`}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    {usedInSongs.length > 0 && (
      <section class="used-in">
        <h2>{chord.name} 코드로 연주하는 노래</h2>
        <div class="song-links">
          {usedInSongs.map((s) => (
            <a class="song-link" href={`${base}/song/${s.slug}/`}>🎵 {s.title}</a>
          ))}
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="related">
        <h2>관련 코드</h2>
        <div class="rel-grid">
          {related.map((c) => (
            <a class="rel" href={`${base}/chord/${chordSlug(c.name)}/`}>{c.name}</a>
          ))}
        </div>
      </section>
    )}
  </article>

  <style>
    .crumb { margin: 4px 0 10px; }
    .crumb a { color: var(--muted); text-decoration: none; font-size: 14px; }
    .chord-head { text-align: center; margin-bottom: 8px; }
    .chord-head h1 { font-size: 40px; margin: 6px 0 2px; letter-spacing: -1px; }
    .chord-head .q { font-size: 15px; color: var(--accent); font-weight: 700; vertical-align: middle; }
    .aka { color: var(--muted); font-size: 13.5px; margin: 0; }
    .diagram-wrap {
      display: flex; justify-content: center; background: var(--card);
      border: 1px solid var(--line); border-radius: 20px; padding: 22px; margin: 14px auto 22px;
      max-width: 280px;
    }
    .howto { max-width: 420px; margin: 0 auto 26px; }
    .howto h2, .related h2, .used-in h2 { font-size: 16px; border-bottom: 1px solid var(--line); padding-bottom: 7px; }
    .howto p { font-size: 15px; }
    table { width: 100%; border-collapse: collapse; margin-top: 10px; }
    th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); font-size: 14.5px; }
    th { color: var(--muted); font-weight: 600; }
    .used-in { max-width: 520px; margin: 0 auto 22px; }
    .song-links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    .song-link {
      background: var(--card); color: var(--ink); font-weight: 600;
      padding: 8px 15px; border-radius: 999px; text-decoration: none; font-size: 14px;
      border: 1px solid var(--line);
    }
    .song-link:hover { border-color: var(--accent); color: var(--accent); }
    .related { max-width: 520px; margin: 0 auto; }
    .rel-grid { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    .rel {
      background: var(--accent-soft); color: var(--accent); font-weight: 700;
      padding: 7px 14px; border-radius: 999px; text-decoration: none; font-size: 14px;
    }
    .rel:hover { background: var(--accent); color: #fff; }
  </style>
</Base>
