---
import Base from "../layouts/Base.astro";
import ChordDiagram from "../components/ChordDiagram.astro";
import { groupedChords, chordSlug } from "../data/chords.js";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const groups = groupedChords();

// 홈 구조화 데이터(@graph): 사이트 엔티티(WebSite) + 코드 사전의 전체 코드 목록(ItemList).
// 코드 목록이 이 페이지의 핵심 콘텐츠라, 검색엔진이 각 코드를 구조화된 항목으로 이해하고
// 개별 코드 상세로 연결하도록 ItemList를 함께 노출한다. (상세엔 BreadcrumbList가 이미 있음)
const siteUrl = new URL(`${base}/`, Astro.site).href;
const allChords = groups.flatMap((g) => g.chords);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "우쿨코드",
      url: siteUrl,
      description: "우쿨렐레 코드·운지법을 다이어그램으로 한눈에 찾는 무료 코드 사전.",
      inLanguage: "ko-KR",
    },
    {
      "@type": "ItemList",
      name: "우쿨렐레 코드 목록",
      numberOfItems: allChords.length,
      itemListElement: allChords.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: new URL(`${base}/chord/${chordSlug(c.name)}/`, Astro.site).href,
        name: `${c.name} 코드`,
      })),
    },
  ],
};
---
<Base>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <section class="intro">
    <h1>우쿨렐레 코드 사전</h1>
    <p>코드를 눌러 운지법 다이어그램을 크게 확인하세요. 표준 튜닝(G·C·E·A) 기준이에요.</p>
  </section>

  {groups.map((g) => (
    <section class="group">
      <h2>{g.label}</h2>
      <div class="grid">
        {g.chords.map((c) => (
          <a class="card" href={`${base}/chord/${chordSlug(c.name)}/`} aria-label={`${c.name} 코드`}>
            <span class="card-name">{c.name}</span>
            <ChordDiagram frets={c.frets} size={0.82} />
          </a>
        ))}
      </div>
    </section>
  ))}

  <style>
    .intro { text-align: center; margin: 6px 0 22px; }
    .intro h1 { font-size: 22px; margin: 0 0 6px; }
    .intro p { color: var(--muted); font-size: 14px; margin: 0; }
    .group { margin: 0 0 28px; }
    .group h2 {
      font-size: 15px; color: var(--muted); font-weight: 700;
      border-bottom: 1px solid var(--line); padding-bottom: 7px; margin: 0 0 14px;
    }
    .grid {
      display: grid; gap: 12px;
      grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    }
    .card {
      display: flex; flex-direction: column; align-items: center; gap: 4px;
      background: var(--card); border: 1px solid var(--line); border-radius: 14px;
      padding: 12px 6px 8px; text-decoration: none;
      transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease;
    }
    .card:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(0,0,0,.07); border-color: var(--accent); }
    .card-name { font-size: 17px; font-weight: 800; letter-spacing: -0.3px; }
  </style>
</Base>
